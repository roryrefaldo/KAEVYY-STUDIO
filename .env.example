# Environment Variables Specification - KAEVY STUDIO Enterprise Phase 10

# Server & Runtime Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=https://kaevy.studio,http://localhost:3000
JWT_SECRET=super-secret-enterprise-jwt-key-min-32-chars-replace-in-production
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL + Drizzle)
DATABASE_URL=postgres://kaevy_user:kaevy_secure_pass@localhost:5432/kaevy_studio_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis Cache & Real-time Socket Adapter
REDIS_URL=redis://:redis_secure_pass@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass

# Object Storage Abstraction (Google Cloud Storage / AWS S3)
STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=kaevy-studio-assets-prod
STORAGE_REGION=ap-southeast-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
GCS_PROJECT_ID=
GCS_KEYFILE_PATH=

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# Client API Config
VITE_API_URL=/api/v1
VITE_SOCKET_URL=http://localhost:3000

# AI & Gemini Integration
GEMINI_API_KEY=

# Environment Variables - Production Specification
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=https://kaevy.studio
JWT_SECRET=production_super_secret_jwt_key_kaevy_studio_2026_change_me
JWT_EXPIRES_IN=7d

DATABASE_URL=postgres://kaevy_user:kaevy_secure_pass@postgres:5432/kaevy_studio_db
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=30

REDIS_URL=redis://:redis_secure_pass@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass

STORAGE_PROVIDER=gcs
STORAGE_BUCKET_NAME=kaevy-studio-assets-prod
STORAGE_REGION=ap-southeast-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
GCS_PROJECT_ID=kaevy-studio-cloud
GCS_KEYFILE_PATH=/app/secrets/gcs-key.json

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

VITE_API_URL=/api/v1
VITE_SOCKET_URL=https://kaevy.studio
GEMINI_API_KEY=
